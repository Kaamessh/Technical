{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/src/server.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "frontend/assets/$1"
    },
    {
      "src": "/Images/(.*)",
      "dest": "frontend/Images/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "frontend/Images/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "frontend/favicon.ico"
    },
    {
      "src": "/favicon.png",
      "dest": "frontend/favicon.png"
    },
    {
      "src": "/icons8-games-16.png",
      "dest": "frontend/icons8-games-16.png"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/index.html"
    }
  ]
}
